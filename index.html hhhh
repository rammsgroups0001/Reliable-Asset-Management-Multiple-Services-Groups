<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>XYZ RAMMS MODELING MANAGEMENT | Elite Talent & Casting Agency</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Montserrat:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #09090b;
      --card-bg: #121216;
      --accent: #d4af37;
      --accent-glow: rgba(212, 175, 55, 0.35);
      --text: #f5f5f7;
      --text-muted: #8a8a93;
      --border: #22222b;
      --ticker-bg: #050507;
      --transition: all 0.35s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Montserrat', sans-serif;
      overflow-x: hidden;
      line-height: 1.6;
    }

    h1, h2, h3, .serif {
      font-family: 'Cormorant Garamond', serif;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* 1. TOP LIVE TICKER & REAL-TIME SYSTEM */
    .top-meta-bar {
      background: var(--ticker-bg);
      border-bottom: 1px solid var(--border);
      font-size: 0.72rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 0.4rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1002;
    }

    .live-status {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      background: #00ff66;
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 10px #00ff66;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 0.4; }
      50% { opacity: 1; }
      100% { opacity: 0.4; }
    }

    .ticker-wrapper {
      overflow: hidden;
      white-space: nowrap;
      position: relative;
      width: 50%;
    }

    .ticker-text {
      display: inline-block;
      padding-left: 100%;
      animation: tickerLoop 24s linear infinite;
      color: var(--accent);
      font-weight: 500;
    }

    @keyframes tickerLoop {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-100%, 0, 0); }
    }

    /* 2. SERVICES QUICK-BAR (TOP HEADER SERVICE RIBBON) */
    .services-ribbon {
      background: #0d0d12;
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 1rem;
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
      font-size: 0.68rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--text-muted);
      position: sticky;
      top: 29px;
      z-index: 1001;
    }

    .service-tag {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .service-tag span {
      color: var(--accent);
    }

    /* 3. MAIN NAVIGATION */
    header {
      position: sticky;
      top: 58px;
      background: rgba(9, 9, 11, 0.95);
      backdrop-filter: blur(12px);
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .logo span {
      color: #fff;
      font-weight: 300;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      transition: var(--transition);
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .btn-gold {
      background: transparent;
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 0.5rem 1.2rem;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 1.5px;
      cursor: pointer;
      transition: var(--transition);
      display: inline-block;
    }

    .btn-gold:hover {
      background: var(--accent);
      color: #000;
      box-shadow: 0 0 15px var(--accent-glow);
    }

    /* 4. HERO SECTION */
    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      background: linear-gradient(rgba(9, 9, 11, 0.7), rgba(9, 9, 11, 0.95)), 
                  url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1920&auto=format&fit=crop') center/cover no-repeat;
      padding: 4rem 1.5rem;
    }

    .hero-content {
      max-width: 900px;
    }

    .hero-tag {
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 4px;
      color: var(--accent);
      margin-bottom: 1rem;
      display: block;
    }

    .hero-title {
      font-size: 3.5rem;
      line-height: 1.15;
      margin-bottom: 1.5rem;
      font-weight: 400;
    }

    .hero-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      max-width: 600px;
      margin: 0 auto 2.5rem;
      font-weight: 300;
    }

    /* 5. MANUAL MODEL CAROUSEL / SLIDER (हाथ से स्विच करने वाला) */
    section {
      padding: 5rem 2rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    .section-title {
      font-size: 2.4rem;
      font-weight: 400;
    }

    .slider-controls {
      display: flex;
      gap: 0.8rem;
    }

    .control-btn {
      width: 45px;
      height: 45px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      transition: var(--transition);
    }

    .control-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Carousel Container */
    .carousel-container {
      position: relative;
      overflow: hidden;
    }

    .carousel-track {
      display: flex;
      gap: 1.8rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none; /* Hide scrollbar Firefox */
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1rem;
    }

    .carousel-track::-webkit-scrollbar {
      display: none; /* Hide scrollbar Chrome/Safari */
    }

    .model-slide {
      flex: 0 0 300px;
      scroll-snap-align: start;
      background: var(--card-bg);
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: var(--transition);
    }

    .model-slide:hover {
      transform: translateY(-8px);
      border-color: var(--accent);
    }

    .model-img {
      width: 100%;
      height: 440px;
      object-fit: cover;
      display: block;
      filter: grayscale(15%);
      transition: transform 0.6s ease, filter 0.6s ease;
    }

    .model-slide:hover .model-img {
      transform: scale(1.04);
      filter: grayscale(0%);
    }

    .model-details {
      padding: 1.2rem;
      background: linear-gradient(0deg, #09090b 20%, transparent 100%);
      position: absolute;
      bottom: 0;
      width: 100%;
      text-align: left;
    }

    .model-name {
      font-size: 1.4rem;
      color: #fff;
    }

    .model-meta {
      font-size: 0.75rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* 6. PROFILE MODAL */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(10px);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-content {
      background: var(--card-bg);
      border: 1px solid var(--border);
      max-width: 850px;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1.2rem;
      background: transparent;
      border: none;
      color: #fff;
      font-size: 1.8rem;
      cursor: pointer;
      z-index: 10;
    }

    .modal-img {
      width: 100%;
      height: 100%;
      min-height: 420px;
      object-fit: cover;
    }

    .modal-body {
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .stats-table {
      width: 100%;
      margin: 1.5rem 0;
      font-size: 0.85rem;
      border-collapse: collapse;
    }

    .stats-table td {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
    }

    .stats-table td:first-child {
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* 7. TALENT REGISTRATION & BOOKING */
    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 4rem 0;
    }

    .action-box {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 3rem 2rem;
      text-align: center;
      transition: var(--transition);
    }

    .action-box:hover {
      border-color: var(--accent);
    }

    .action-box h3 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .action-box p {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-bottom: 2rem;
    }

    /* 8. FOOTER */
    footer {
      background: #050507;
      padding: 4rem 2rem 2rem;
      border-top: 1px solid var(--border);
    }

    .footer-container {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .footer-col h4 {
      font-size: 1rem;
      margin-bottom: 1.2rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .footer-links {
      list-style: none;
    }

    .footer-links li {
      margin-bottom: 0.6rem;
    }

    .footer-links a {
      color: var(--text-muted);
      font-size: 0.85rem;
      transition: var(--transition);
    }

    .footer-links a:hover {
      color: #fff;
    }

    @media (max-width: 900px) {
      .ticker-wrapper { display: none; }
      .action-grid, .modal-content, .footer-container { grid-template-columns: 1fr; }
      .nav-links { display: none; }
      .hero-title { font-size: 2.6rem; }
      .model-slide { flex: 0 0 240px; }
    }
  </style>
</head>
